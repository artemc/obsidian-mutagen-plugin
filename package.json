{
  "name": "obsidian-mutagen-sync",
  "version": "0.1.5",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test:integration": "esbuild test/integration.ts --bundle --platform=node --alias:obsidian=./test/obsidian-stub.ts --outfile=test/.out/integration.js --log-level=error && node test/.out/integration.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.4.0"
  }
}
